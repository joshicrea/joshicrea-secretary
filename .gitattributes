# シェルスクリプトはLF必須（Unix実行用）
# CRLF になると Mac/Linux で `#!/usr/bin/env bash\r` となり bad interpreter で起動しない。
# 2026-07-28 追加: AI経営者には同等の指定があったが、この製品には無く CRLF が混入していた。
hooks/session-start text eol=lf
hooks/session-log text eol=lf
install.py text eol=lf
*.sh text eol=lf

# PowerShell は CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
